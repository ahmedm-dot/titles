# Public hostname for the MCP server (DNS A/AAAA record must point here).
MCP_DOMAIN=mcp.infrozix.com

# Where the MCP server calls the PostHog API.
POSTHOG_API_BASE_URL=https://ph.infrozix.com

# Public PostHog URL. Also the OAuth authorization server. Must be https.
POSTHOG_PUBLIC_URL=https://ph.infrozix.com

# ghcr.io/posthog/posthog-mcp tag. Pin to a sha-xxxxxxx tag in production.
MCP_IMAGE_TAG=master
