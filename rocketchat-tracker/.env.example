# Rocket.Chat server and your Personal Access Token
# (Rocket.Chat → Avatar → Profile → Personal Access Tokens)
RC_URL=https://rc1.infrozix.com
RC_USER_ID=your-user-id
RC_TOKEN=your-personal-access-token

# How often to check for new messages (seconds, minimum 15)
POLL_SECONDS=60
# On first run, how far back to scan (hours)
LOOKBACK_HOURS=48

# Extra words that create a card from ANY room, even without a mention (comma separated)
WATCH_KEYWORDS=requirement,urgent,asap,blocker,ats,auto apply,resumedone
# Rooms to ignore for keyword matching (mentions/DMs from them still show)
MUTED_ROOMS=general,random
# Create cards for @all / @here mentions (true/false)
INCLUDE_GROUP_MENTIONS=true

# Web board address. Keep 127.0.0.1 so only you can open it.
PORT=3000
HOST=127.0.0.1
